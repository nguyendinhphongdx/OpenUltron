{
  "name": "ultron",
  "version": "0.0.1",
  "private": true,
  "description": "Ultron — personal AI agent platform (API + web + mobile + desktop) trên nền OpenJarvis agent-engine",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:infra": "docker compose -f infra/docker-compose.yml up -d",
    "dev:infra:stop": "docker compose -f infra/docker-compose.yml down",
    "dev:infra:reset": "docker compose -f infra/docker-compose.yml down -v"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@swc/core",
      "esbuild",
      "@nestjs/core"
    ]
  }
}
