# App env — copy → .env (gitignored)

ENV=development
PORT=8000

# Database (ADR-0003) — Postgres + pgvector, chạy qua infra/docker-compose.yml
DATABASE_URL=postgresql+asyncpg://ultron:ultron@127.0.0.1:5432/ultron

# Ollama local (ADR-0007 — provider "ollama")
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# Provider API key (ADR-0007) — chỉ cần khi tạo Model với provider tương ứng, KHÔNG lưu trong DB
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS — origin của apps/web (browser gọi thẳng apps/api), cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
