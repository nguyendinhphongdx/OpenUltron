# App env — copy → .env (gitignored)

ENV=development
PORT=8000

# Database (ADR-0003) — Postgres + pgvector, chạy qua infra/docker-compose.yml
DATABASE_URL=postgresql+asyncpg://ultron:ultron@127.0.0.1:5432/ultron

# Ollama local (ADR-0007 — provider "ollama")
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# Provider API key (gemini/openai) KHÔNG còn ở đây (ADR-0010) — nhập qua API
# `PUT /credentials/{provider}`, lưu mã hoá trong DB (module `credential`).

# AES-256-GCM key (ADR-0010, base64, decode ra đúng 32 byte) — mã hoá Credential.ciphertext tại
# rest. Tạo mới: `python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"`
APP_ENCRYPTION_KEY=

# CORS — origin của apps/web (browser gọi thẳng apps/api), cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
